SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Required in production; use a unique random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
STELLAR_HORIZON_URL=https://horizon.stellar.org
# Optional Soroban RPC override; use an archival endpoint for the full 90-day history.
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_CONTRACT_ID=your-wave-hub-contract-id
NEXT_PUBLIC_CONTRACT_NETWORK=testnet
# USDC SAC contract for the selected network; required for treasury history.
NEXT_PUBLIC_USDC_SAC=your-network-usdc-sac-contract-id
